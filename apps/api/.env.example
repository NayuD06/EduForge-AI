# ===== EduForge API (NestJS) =====
NODE_ENV=development
PORT=4000
# Các origin được phép gọi API (web, admin, Expo web/dev tools)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081

# PostgreSQL + pgvector (docker-compose)
DATABASE_URL=postgresql://eduforge:eduforge@localhost:5432/eduforge?schema=public

# Redis cho BullMQ (hàng đợi auto-submit hết giờ + job AI)
REDIS_URL=redis://localhost:6379

# JWT – đổi giá trị này trong môi trường thật!
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Lưu file PDF tài liệu khóa học
#  local = ghi vào apps/api/storage (mặc định, không cần cài gì)
#  s3    = AWS S3 / Cloudflare R2 / MinIO (docker compose --profile s3 up -d)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=eduforge
S3_ACCESS_KEY=eduforge
S3_SECRET_KEY=eduforge123
S3_FORCE_PATH_STYLE=true

# ===== AI =====
# Claude API – sinh câu hỏi từ PDF, giải thích đáp án. Lấy key tại https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Embedding cho RAG (Voyage AI, 1024 chiều). Để trống = tìm kiếm full-text Postgres thay thế.
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-3.5
